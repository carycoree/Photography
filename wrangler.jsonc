{
  "name": "adrian-yeh-photography",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "assets": {"directory":"./dist/client", "binding":"ASSETS", "run_worker_first":true, "html_handling":"none"},
  "d1_databases": [{"binding":"DB", "database_name":"photography-db", "database_id":"REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir":"drizzle"}],
  "r2_buckets": [{"binding":"BUCKET", "bucket_name":"photography-images"}],
  "vars": {
    "AUTH_MODE":"cloudflare",
    "ADMIN_EMAILS":"you@example.com",
    "ACCESS_TEAM_DOMAIN":"https://your-team.cloudflareaccess.com",
    "ACCESS_AUD":"REPLACE_WITH_YOUR_ACCESS_APPLICATION_AUD"
  }
}
