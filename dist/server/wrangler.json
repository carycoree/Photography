{
  "name": "adrian-yeh-photography",
  "main": "./index.js",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "../client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "photography-db",
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "photography-images"
    }
  ]
}